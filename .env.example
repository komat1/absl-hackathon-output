# Analytics pool — read-only role, cannot write by design.
DATABASE_URL_RO=postgresql://copilot_ro:copilot_ro@localhost:5434/copilot
# Write pool — only apply_deal_update uses it.
DATABASE_URL_RW=postgresql://copilot_rw:copilot_rw@localhost:5434/copilot
# Superuser, used by the seed script only.
DATABASE_URL_ADMIN=postgresql://postgres:postgres@localhost:5434/copilot

# Pick one. Without a key the API still runs and the /query endpoints work;
# only the chat agent needs it.
ANTHROPIC_API_KEY=
COPILOT_MODEL=claude-sonnet-5-5

# The dataset's reference date. Everything "today" in the app means this.
REFERENCE_DATE=2026-10-31
